# Environment variables
# Variables ending with _PUBLIC will be visible on-chain
# All other variables will be encrypted

# Example public variable
# API_URL_PUBLIC=https://api.example.com

# Example private variable
# SECRET_KEY=your-secret-key-here

# Eigen Gateway Configuration
EIGEN_GATEWAY_URL=https://ai-gateway.eigencloud.xyz

# Attestation-based auth (set automatically in confidential compute environments)
# KMS_SERVER_URL=http://10.128.0.57:8080
# KMS_PUBLIC_KEY=<pem contents>

# Optional JWT override (bypasses attestation)
# KMS_AUTH_JWT=your-jwt-token-here